name = "ugyfelkozpont-api"
main = "src/index.ts"
compatibility_date = "2026-05-18"
workers_dev = true
preview_urls = false

[observability]
enabled = true
head_sampling_rate = 1

[[d1_databases]]
binding = "DB"
database_name = "ugyfelkozpont"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"

[[kv_namespaces]]
binding = "RATE_LIMIT_KV"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

[vars]
GEMINI_MODEL = "gemini-3.1-flash-lite"
GEMINI_MODEL_PREMIUM = "gemini-3.5-flash"
GEMINI_REVIEW_MODEL = "gemini-3.1-flash-lite"
SITE_URL = "https://levelseged.hu"
ALLOWED_ORIGINS = "https://levelseged.hu,https://epatrik107.github.io"
TURNSTILE_EXPECTED_HOSTNAMES = "levelseged.hu"
LEGAL_TERMS_VERSION = "1.5"
PRIVACY_POLICY_VERSION = "1.3"
ADMIN_API_ENABLED = "false"
EMAIL_FROM = "Levélsegéd <noreply@levelseged.hu>"
DEMO_MODE = "true"
PAYMENTS_ENABLED = "false"
PAYMENT_MODE = "test"

# Add these as secrets in payment environments:
# - SZAMLAZZ_AGENT_KEY: Számlázz.hu Agent key
# - ADMIN_API_TOKEN: sandbox-only fallback; production admin API stays disabled

[triggers]
crons = [ "* * * * *" ]
