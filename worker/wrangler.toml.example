name = "ugyfelkozpont-api"
main = "src/index.ts"
compatibility_date = "2026-05-18"
workers_dev = true
preview_urls = false

[[d1_databases]]
binding = "DB"
database_name = "ugyfelkozpont"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"

[[kv_namespaces]]
binding = "RATE_LIMIT_KV"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

[vars]
GEMINI_MODEL = "gemini-3.1-flash-lite"
GEMINI_MODEL_PREMIUM = "gemini-3.5-flash"
GEMINI_REVIEW_MODEL = "gemini-3.1-flash-lite"
SITE_URL = "https://epatrik107.github.io/ugyfelszolg"
ALLOWED_ORIGINS = "https://xn--gyfelszolgalat-fsb.hu,https://epatrik107.github.io"
EMAIL_FROM = "Ügyfélközpont <noreply@xn--gyfelszolgalat-fsb.hu>"
DEMO_MODE = "true"
PAYMENTS_ENABLED = "false"
PAYMENT_MODE = "test"

# Add these as secrets in payment environments:
# - SZAMLAZZ_AGENT_KEY: Számlázz.hu Agent key
# - ADMIN_API_TOKEN: bearer token for invoice status/retry admin endpoints

[triggers]
crons = [ "17 2 * * *" ]
