# This file documents names and safe placeholders only. Never commit real values.

# Frontend build variables — public and visible in the browser bundle
VITE_API_BASE_URL=https://api.example.com
VITE_BASE_PATH=/
VITE_TURNSTILE_SITE_KEY=<PUBLIC_TURNSTILE_SITE_KEY>
VITE_SITE_URL=https://app.example.com
VITE_DEMO_MODE=false

# Worker secrets — server-side only
STRIPE_SECRET_KEY=<STRIPE_TEST_OR_LIVE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_ENDPOINT_SIGNING_SECRET>
GEMINI_API_KEY=<RESTRICTED_GEMINI_AUTH_KEY>
TURNSTILE_SECRET_KEY=<TURNSTILE_SECRET_KEY>
TOKEN_HASH_SECRET=<AT_LEAST_32_RANDOM_CHARACTERS>
RESEND_API_KEY=<RESEND_API_KEY>
SZAMLAZZ_AGENT_KEY=<SZAMLAZZ_AGENT_KEY>

# Worker configuration — not secrets, but environment-specific
PAYMENT_MODE=test
PAYMENTS_ENABLED=false
SITE_URL=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com
TURNSTILE_EXPECTED_HOSTNAMES=app.example.com
LEGAL_TERMS_VERSION=<PUBLISHED_TERMS_VERSION>
PRIVACY_POLICY_VERSION=<PUBLISHED_PRIVACY_VERSION>
ADMIN_API_ENABLED=false
GEMINI_MODEL=<PINNED_STANDARD_MODEL_ID>
GEMINI_MODEL_PREMIUM=<PINNED_PREMIUM_MODEL_ID>
GEMINI_REVIEW_MODEL=<PINNED_REVIEW_MODEL_ID>
EMAIL_FROM="Service Name <noreply@example.com>"
DEMO_MODE=false
SZAMLAZZ_TEST_ACCOUNT_CONFIRMED=false
SELLER_NAME=<LEGAL_SELLER_NAME>
SELLER_ADDRESS=<LEGAL_SELLER_ADDRESS>
SELLER_TAX_NUMBER=<LEGAL_SELLER_TAX_NUMBER>

# Demo environments only — never configure this in production
DEMO_ACCESS_CODE=<AT_LEAST_16_RANDOM_CHARACTERS>

# Sandbox admin fallback only. Production keeps ADMIN_API_ENABLED=false until
# an identity-aware access layer is verified.
ADMIN_API_TOKEN=<AT_LEAST_32_RANDOM_CHARACTERS>

# GitHub Environment / Cloudflare deployment configuration
CLOUDFLARE_API_TOKEN=<LEAST_PRIVILEGE_DEPLOY_TOKEN>
CLOUDFLARE_ACCOUNT_ID=<CLOUDFLARE_ACCOUNT_ID>
CLOUDFLARE_D1_DATABASE_ID=<D1_DATABASE_UUID>
CLOUDFLARE_KV_NAMESPACE_ID=<KV_NAMESPACE_ID>
D1_DATABASE_NAME=<D1_DATABASE_NAME>
WORKER_NAME=<WORKER_NAME>
API_HEALTH_URL=https://api.example.com/api/health
